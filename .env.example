# Opcional: URL do servidor de reservas (sem /api no final).
# Sem servidor, o formulário prepara a solicitação para envio pelo WhatsApp.
VITE_API_URL=
# Número oficial no formato 55DDNNNNNNNNN.
# Vazio mantém o comportamento original: escolher o contato no WhatsApp.
VITE_WHATSAPP_NUMBER=
# Substitua pela página oficial da pousada no Airbnb.
VITE_AIRBNB_URL=https://www.airbnb.com.br
