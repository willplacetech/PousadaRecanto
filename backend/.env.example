# API (Node 22.12+). Copie para .env privado; nunca publique credenciais.
PORT=3000
NODE_ENV=development
MONGODB_URI=
MONGODB_DB_NAME=pousada_recanto
JWT_SECRET=
JWT_EXPIRES_IN=7d
CRON_SECRET=
# URL publica da API e origens do frontend separadas por virgula
PUBLIC_API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Render: TRUST_PROXY=1 (somente atras do proxy controlado)
TRUST_PROXY=
# Id retornado pelo provisionamento. Sem id, reservas publicas ficam desabilitadas.
POUSADA_PUBLICA_ID=
# Configurados somente para executar npm run provisionar; remover senha depois.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
POUSADA_NOME=Pousada Recanto da Paz
POUSADA_EMAIL=
POUSADA_WHATSAPP=
# IMAP configurado por pousada no painel (senha de aplicativo, TLS)
# IA: padrao Gemini, opcional openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Dupla habilitacao: ambiente + configuracao da pousada no painel
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
