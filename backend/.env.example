# Servidor
PORT=3000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/pousada_recanto?retryWrites=true&w=majority

# JWT
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_min_32_chars
JWT_EXPIRES_IN=7d

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# iCal Token Secret (para gerar tokens por pousada)
ICAL_TOKEN_SECRET=seu_ical_token_secret_aqui

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_auth_token_aqui
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
POUSADA_WHATSAPP_TO=whatsapp:+55DD9NNNNNNNN

# E-mail (IMAP para monitoramento)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=seu_email@gmail.com
EMAIL_IMAP_PASS=sua_senha_de_app
EMAIL_FROM=noreply@pousadarecanto.com

# LLM (OpenAI/Gemini) - para extração de e-mails
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Frontend URL (para CORS)
FRONTEND_URL=https://pousadarecanto.onrender.com

# Cron Job Secret (para endpoints de sync chamados pelo cron-job.org)
CRON_SECRET=seu_cron_secret_super_seguro_aqui